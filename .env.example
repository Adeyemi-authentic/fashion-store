# Copy to .env and fill in. Never commit .env.
# Each value says which app reads it: [api], [web] or [both].

# --- General ---
APP_ENV=development                      # [both] development | test | production
BRAND_NAME=FlyFit                        # [both] single place to swap the brand name
PUBLIC_SITE_URL=http://localhost:3000    # [both] storefront origin; Paystack callback lands here
API_BASE_URL=http://localhost:8000       # [web]  where Next.js rewrites /api/* to (server-side only)
SESSION_SECRET=change-me-32-bytes-min    # [api]  signs session cookies
PROXY_SHARED_SECRET=change-me            # [both] Next.js sends it as X-Proxy-Auth; API trusts X-Forwarded-For only with it

# --- Neon Postgres + pgvector (a NEW Neon project, never another project's URL) ---
DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx-pooler.region.aws.neon.tech/flyfit?sslmode=require   # [api] pooled, used by the app
DATABASE_URL_DIRECT=postgresql+psycopg://user:pass@ep-xxx.region.aws.neon.tech/flyfit?sslmode=require   # [api] direct, used by Alembic migrations

# --- Paystack (TEST MODE keys only: sk_test_ / pk_test_) ---
# Webhook signatures are HMAC-SHA512 of the raw body using PAYSTACK_SECRET_KEY.
PAYSTACK_SECRET_KEY=sk_test_xxx          # [api]
PAYSTACK_PUBLIC_KEY=pk_test_xxx          # [web]
HOLD_MINUTES=15                          # [api] stock hold length
RATE_LIMIT_CHECKOUT_PER_MIN=10           # [api] per IP and per customer
RATE_LIMIT_ASSISTANT_PER_MIN=20          # [api] per IP and per customer
RATE_LIMIT_LOGIN_PER_MIN=10              # [api] login and sign-up, per IP and per session

# --- AI ---
ANTHROPIC_API_KEY=                       # [api] Claude (claude-haiku-5-5 while building)
VOYAGE_API_KEY=                          # [api] embeddings
IMAGE_GEN_API_KEY=                       # [scripts] OpenAI key for product images (scripts/generate_images.py)
IMAGE_GEN_MODEL=gpt-image-2              # [scripts] fallback: gpt-image-1.5
ASSISTANT_DAILY_SPEND_CAP_USD=2.00       # [api] hard cap for the shopping assistant

# --- Email ---
RESEND_API_KEY=                          # [api] empty = emails are written to api/.emails/<job>.json
EMAIL_FROM=FlyFit <orders@example.com>   # [api]
ADMIN_EMAIL=admin@example.com            # [api] low-stock and review alerts

# --- Observability ---
SENTRY_DSN=                              # [both] empty = disabled
LOG_LEVEL=INFO                           # [api]
METRICS_TOKEN=                           # [api] set in production: /metrics then needs 'Authorization: Bearer <token>'

# --- Outbox worker ---
WORKER_IN_API=true                       # [api] run the worker inside the API process (free tier); false = run `python -m app.worker_main`
WORKER_LEASE_SECONDS=60                  # [api] a killed worker's job is retried after this
WORKER_POLL_SECONDS=1                    # [api]
